# ============================================
# AI NewsDesk · AI 行业动态聚合器 - 环境变量配置模板
# ============================================
# 复制本文件为 .env 并填写你的配置
#   Windows: copy .env.example .env
#   Linux/macOS: cp .env.example .env
# ============================================

# --- LLM API 配置 ---
# 在所用供应商的开放平台注册后创建 API Key 填入
DEEPSEEK_API_KEY=
# 模型名称（默认即可）
DEEPSEEK_MODEL=deepseek-chat
# API 地址（OpenAI 兼容）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- 数据库配置 ---
# SQLite 数据库文件路径（相对于项目根目录）
DATABASE_PATH=data/ai_news.db

# --- 采集配置 ---
# 采集间隔（分钟）
COLLECT_INTERVAL_MINUTES=60
# 每天自动采集的整点小时（24小时制，逗号分隔）
COLLECT_CRON_HOURS=8,20

# --- 应用配置 ---
# 应用标题（显示在浏览器标签页）
APP_TITLE=AI 行业动态聚合
# 每页显示条数
PAGE_SIZE=50
# 服务端口
PORT=9999

# --- 认证配置 ---
# 会话 cookie 签名密钥。建议写死一个随机值（改了全员登出）。
# 可用 python -c "import secrets;print(secrets.token_hex(32))" 生成
SESSION_SECRET=

# --- 日报配置 ---
# 每日日报生成时间（24小时制），默认每天 20:30
REPORT_CRON_HOUR=20
REPORT_CRON_MINUTE=30
# 对外访问地址（钉钉日报推送里「查看完整日报」链接用它拼接）
PUBLIC_BASE_URL=http://127.0.0.1:9999

# --- 钉钉推送配置 ---
# 钉钉群机器人 Webhook URL（不配置则不推送，留空不影响其他功能）
# 也可留空，后续在页面设置弹窗里管理多个群
DINGTALK_WEBHOOK_URL=
